APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO
DEFAULT_TRANSLATOR=argos
DEFAULT_SOURCE_LANGUAGE=en
MAX_TEXT_LENGTH=20000
TRANSLATION_TIMEOUT_SECONDS=30
MARIAN_MODELS_DIR=~/.local/share/babelfish/marian
MARIAN_DEVICE=cpu
MARIAN_COMPUTE_TYPE=int8
DEFAULT_ANNOTATOR=iishko
IISHKO_API_KEY=
IISHKO_BASE_URL=https://api.reformboss.com/v1
IISHKO_MODEL=qwen3.8-flash
QWEN_LOCAL_BASE_URL=http://127.0.0.1:8081/v1
QWEN_LOCAL_MODEL=qwen3-4b
ANNOTATION_MAX_INPUT_CHARS=2000000
ANNOTATION_MAX_TEXT_CHARS=20000
ANNOTATION_MAX_DOWNLOAD_BYTES=2000000
ANNOTATION_FETCH_TIMEOUT_SECONDS=10
# Optional public resolver for environments with mapped DNS (for example 1.1.1.1).
ANNOTATION_DNS_SERVER=
ANNOTATION_PROVIDER_TIMEOUT_SECONDS=90
ANNOTATION_TIMEOUT_SECONDS=100
